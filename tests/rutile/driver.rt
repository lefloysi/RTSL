[[test]]
fn compiler_driver_orders_supplied_imports_and_rejects_missing_or_cyclic_inputs() {
 rtsl::CompilerInstance valid;
 @valid.add_source("main.rtsl", "import \"helper.rtsl\"; fn main() -> f32 { return twice(2.0); };");
 @valid.add_source("helper.rtsl", "fn twice(f32 value) -> f32 { return value + value; };");
 rt::test::expect((@valid.analyze()).has<void>());
 rtsl::CompilerInstance missing;
 @missing.add_source("main.rtsl", "import \"absent.rtsl\";");
 rt::test::expect((@missing.analyze()).has<rtsl::compilation_error>());
 rtsl::CompilerInstance cycle;
 @cycle.add_source("a.rtsl", "import \"b.rtsl\";");
 @cycle.add_source("b.rtsl", "import \"a.rtsl\";");
 rt::test::expect((@cycle.analyze()).has<rtsl::compilation_error>());
};

[[test]]
fn language_server_resolves_hover_definition_and_utf16_positions() {
 rtsl::lsp::Document document;
 @document.uri = rt::string("file:///C:/fixture/source.rtsl");
 @document.text = rt::string("fn square(f32 value) -> f32 { return value * value; };");
 var hover = rtsl::lsp::hover(document, 4);
 rt::test::expect(hover == "{\"contents\":{\"kind\":\"plaintext\",\"value\":\"fn square(f32 value) -> f32\"}}");
 var definition = rtsl::lsp::definition(document, 37);
 rt::test::expect(definition == "{\"uri\":\"file:///C:/fixture/source.rtsl\",\"range\":{\"start\":{\"line\":0,\"character\":14},\"end\":{\"line\":0,\"character\":19}}}");
 rt::test::expect(rtsl::lsp::utf16_length("a😀z") == 4);
 rt::test::expect(rtsl::lsp::offset_at("a😀z",0,3) == 5);
 rt::test::expect(rtsl::lsp::uri_path("file:///C:/with%20space/shader.rtsl") == "C:/with space/shader.rtsl");
};

[[test]]
fn language_server_formatter_keeps_shell_characters_in_document_paths_literal() {
	rtsl::lsp::Document document;
	@document.uri = rt::string("file:///C:/fixture/with%20space%20%26%20caret%5E/source.rtsl");
	@document.text = rt::string("int answer(){return 42;}");
	var files = rt::unique<FormatFiles, FormatFilesDelete>(rtsl_format_files_create(document.text.data(), document.text.size()));
	rt::test::expect(files.get() != nullptr);
	rt::string configured = rt::environment("RTSL_FORMATTER");
	bool explicitly_configured = !configured.empty();
	if (configured.empty()) { @configured = rt::string("clang-format"); };
	bool executable = rtsl_format_files_command(files.get(), configured.c_str(), "source.rtsl.cpp\0".data()) != nullptr;
	if (explicitly_configured) { rt::test::expect(executable); };
	var formatted = rtsl::lsp::formatted(document);
	if (executable) {
		rt::test::expect(formatted.trim() == "int answer() { return 42; }");
	}
	else {
		rt::test::expect(formatted == document.text || formatted.trim() == "int answer() { return 42; }");
	};
	if (rt::environment("OS") == "Windows_NT") {
		@document.uri = rt::string("file:///C:/fixture/%25TEMP%25/source.rtsl");
		rt::test::expect(rtsl::lsp::formatted(document) == document.text);
	};
};

[[test]]
fn compiler_driver_round_trips_generic_module_interfaces_into_a_separate_instance() {
 rtsl::CompilerInstance producer;
 @producer.add_source("generic.rtsl", "export template<typename T> fn identity(T value) -> T { return value; };");
 var encoded = @producer.emit_interface("generic");
 rt::test::expect(encoded.has<rt::buffer<u08>>());
 rt::buffer<u08>& bytes = encoded.get<rt::buffer<u08>>();
 var decoded = rtsl::read_interface(rt::span<u08>(bytes.data(),bytes.size()));
 rt::test::expect(decoded.has<rtsl::ModuleInterface>());
 rtsl::CompilerInstance consumer;
 rt::test::expect((@consumer.add_interface(decoded.get<rtsl::ModuleInterface>())).has<void>());
 @consumer.add_source("consumer.rtsl", "import <generic>; fn use(f32 value) -> f32 { return identity<f32>(value); };");
 var object = @consumer.compile("consumer",rtsl::artifact_kind::object);
 rt::test::expect(object.has<rt::buffer<u08>>());
};

[[test]]
fn language_server_references_exclude_call_punctuation_and_signature_help_tracks_arguments() {
 rtsl::lsp::Document document;
 @document.uri = rt::string("file:///C:/fixture/references.rtsl");
 @document.text = rt::string("fn square(f32 value) -> f32 { return value * value; }; fn use() -> f32 { return square(2.0); };");
 var references = rtsl::lsp::references(document,82,false);
 rt::test::expect(references == "[{\"uri\":\"file:///C:/fixture/references.rtsl\",\"range\":{\"start\":{\"line\":0,\"character\":80},\"end\":{\"line\":0,\"character\":86}}}]");
 var signature = rtsl::lsp::signature_help(document,88);
 rt::test::expect(signature == "{\"signatures\":[{\"label\":\"fn square(f32 value) -> f32\"}],\"activeSignature\":0,\"activeParameter\":0}");
};
