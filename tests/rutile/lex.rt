[[test]]
fn shader_lexer_uses_rutile_declarations_and_mutation_tokens() {
	rtsl::SourceFile source;
	@source.assign("shader.rt", "fn main() { var value = 1.5e-2; @value = $value; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rt::test::expect(source.tokens().data()[0].kind == rtsl::token_kind::kw_fn);
	rt::test::expect(source.tokens().data()[5].kind == rtsl::token_kind::kw_var);
	rt::test::expect(source.tokens().data()[8].text() == "1.5e-2");
	rt::test::expect(source.tokens().data()[10].kind == rtsl::token_kind::op_access);
	rt::test::expect(source.tokens().data()[13].kind == rtsl::token_kind::op_relocate);
	rt::test::expect(source.tokens().data()[source.token_count() - 1].kind == rtsl::token_kind::eof);
};

[[test]]
fn shader_source_ownership_preserves_tokens_when_other_files_are_added() {
	rtsl::SourceManager sources;
	var rtsl::SourceFile* original = @sources.add("first.rt", "fn first();");
	var lexer = rtsl::Lexer(@*original);
	rt::test::expect((@lexer.scan()).has<void>());
	for (usize index = 0; index < 128; @index = index + 1) {
		discard @sources.add("other.rt", "fn other();");
	};
	rt::test::expect(sources.count() == 129);
	rt::test::expect(original->tokens().data()[1].text() == "first");
	rt::test::expect(original->path() == "first.rt");
};

[[test]]
fn shader_lexer_reports_unterminated_input_at_its_source_location() {
	rtsl::SourceFile source;
	@source.assign("broken.rt", "// comment\r\n/* unfinished");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect(!(@lexer.scan()).has<void>());
	var location = lexer.error_token();
	rt::test::expect(location.line == 2);
	rt::test::expect(location.column == 1);
	rt::test::expect(location.begin == 12);
	rtsl::DiagnosticsEngine diagnostics;
	@diagnostics.report(rtsl::diagnostic_level::error, location, lexer.error());
	rt::test::expect(diagnostics.failed());
	rt::test::expect(diagnostics.diagnostics().data()[0].location.source->path() == "broken.rt");
	rt::test::expect(!diagnostics.diagnostics().data()[0].message.empty());
	@diagnostics.clear();
	rt::test::expect(!diagnostics.failed());
};

[[test]]
fn shader_lexer_keeps_utf8_literal_bytes_and_resets_on_rescan() {
	rtsl::SourceFile source;
	@source.assign("text.rt", "\"Grüße\" // preserved comment\n");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rt::test::expect(source.tokens().data()[0].text() == "\"Grüße\"");
	rt::test::expect(source.comments().size() == 1);
	usize count = source.token_count();
	rt::test::expect((@lexer.scan()).has<void>());
	rt::test::expect(source.token_count() == count);
	rt::test::expect(source.comments().size() == 1);
};
