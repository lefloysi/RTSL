fn puts(char* text) -> i32;

[[test]]
fn shader_semantics_resolve_original_return_emitter_operators() {
	rtsl::SourceFile source;
	@source.assign("emitter.rtsl", "struct Vertex { f32 x; }; struct End {}; const var End end; template<typename T, usize N> struct triangle_strip { fn operator<-(T value) -> triangle_strip<T,N>; fn operator<-(End marker) -> triangle_strip<T,N>; }; [[stage : geometry]] fn main(Vertex vertex) -> triangle_strip<Vertex,3> { emit vertex; __return <- vertex; emit end; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	var analyzed = @sema.analyze();
	if (!analyzed.has<void>()) {
		for (usize i = 0; i < diagnostics.diagnostics().size(); @i = i + 1) {
			discard puts(diagnostics.diagnostics().data()[i].message.c_str());
		};
	};
	rt::test::expect(analyzed.has<void>());
	usize emissions = 0;
	u32 vertex_operator = 0;
	u32 end_operator = 0;
	for (usize i = 0; i < context.expressions.size(); @i = i + 1) {
		rtsl::Expr& expression = context.expressions.data()[i];
		if (expression.kind == rtsl::expr_kind::binary && expression.opcode == rtsl::token_kind::op_emit) {
			rt::test::expect(context.expr_at(expression.left)->kind == rtsl::expr_kind::emitter);
			rt::test::expect(context.decl_at(expression.declaration)->name.is("operator<-"));
			rt::test::expect(context.decl_at(expression.declaration)->receiver_type.type != 0);
			if (emissions < 2) {
				if (!vertex_operator) { @vertex_operator = expression.declaration; };
				rt::test::expect(vertex_operator == expression.declaration);
			}
			else { @end_operator = expression.declaration; };
			@emissions = emissions + 1;
		};
	};
	rt::test::expect(emissions == 3);
	rt::test::expect(vertex_operator != end_operator);
};

[[test]]
fn shader_semantics_reject_invalid_return_emitter_operands() {
	rtsl::SourceFile source;
	@source.assign("invalid-emitter.rtsl", "struct Vertex {}; template<typename T, usize N> struct triangle_strip { fn operator<-(T value) -> triangle_strip<T,N>; }; fn ordinary(Vertex vertex) -> triangle_strip<Vertex,3> { vertex <- vertex; }; fn wrong_value(Vertex vertex) -> triangle_strip<Vertex,3> { __return <- 3; }; fn wrong_result() -> f32 { emit 1.0; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	rt::test::expect((@sema.analyze()).has<rtsl::compilation_error>());
	bool invalid_left = false;
	bool invalid_value = false;
	bool invalid_return = false;
	for (usize i = 0; i < diagnostics.diagnostics().size(); @i = i + 1) {
		var message = diagnostics.diagnostics().data()[i].message.view();
		if (message == "left operand of '<-' is not an emitter") { @invalid_left = true; };
		if (message == "no '<-' overload accepts this emitted value") { @invalid_value = true; };
		if (message == "the return emitter requires a geometry primitive return type") { @invalid_return = true; };
	};
	rt::test::expect(invalid_left && invalid_value && invalid_return);
};

[[test]]
fn shader_semantics_analyze_bezier_tessellation_fixture() {
	var std_read = rt::fs::read("std/std.rtsl");
	var shader_read = rt::fs::read("bezier.rtsl");
	rt::test::expect(std_read.has<rt::string>());
	rt::test::expect(shader_read.has<rt::string>());
	rtsl::CompilerInstance compiler;
	@compiler.add_source("std", std_read.get<rt::string>());
	@compiler.add_source("bezier.rtsl", shader_read.get<rt::string>());
	var analyzed = @compiler.analyze();
	if (!analyzed.has<void>()) {
		for (usize i = 0; i < compiler.diagnostics().size(); @i = i + 1) {
			discard puts(compiler.diagnostics().data()[i].message.c_str());
		};
	};
	rt::test::expect(analyzed.has<void>());
	usize indexed_points = 0;
	for (usize i = 0; i < compiler.context().expressions.size(); @i = i + 1) {
		rtsl::Expr& expression = compiler.context().expressions.data()[i];
		if (expression.kind == rtsl::expr_kind::member && expression.location.is("position") && compiler.context().expr_at(expression.left)->kind == rtsl::expr_kind::subscript) {
			@indexed_points = indexed_points + 1;
		};
	};
	rt::test::expect(indexed_points == 4);
};

[[test]]
fn shader_semantics_preserve_patch_domain_coordinate_types() {
	rtsl::SourceFile source;
	@source.assign("patch-domains.rtsl", "struct vec2 { f32 x; f32 y; }; struct Point { f32 value; }; template<typename T> struct triangle_patch {}; template<typename T> struct quad_patch {}; template<typename T> struct isoline_patch {}; [[stage : tess_eval]] fn triangle_coordinate(const triangle_patch<Point>& p) -> vec2 { return p.coordinate; }; [[stage : tess_eval]] fn quad_coordinate(const quad_patch<Point>& p) -> vec2 { return p.coordinate; }; [[stage : tess_eval]] fn isoline_coordinate(const isoline_patch<Point>& p) -> f32 { return p.coordinate; }; fn indexed(const triangle_patch<Point>& p) -> f32 { return p[0].value; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	rt::test::expect((@sema.analyze()).has<void>());
	usize coordinates = 0;
	for (usize i = 0; i < context.expressions.size(); @i = i + 1) {
		rtsl::Expr& expression = context.expressions.data()[i];
		if (expression.kind == rtsl::expr_kind::member && expression.location.is("coordinate")) {
			rtsl::Type* type = context.type_at(expression.type.type);
			if (coordinates < 2) {
				rt::test::expect(type->kind == rtsl::type_kind::named && type->name.is("vec2"));
			}
			else {
				rt::test::expect(type->kind == rtsl::type_kind::builtin && type->builtin == rtsl::builtin_type::floating);
			};
			@coordinates = coordinates + 1;
		};
	};
	rt::test::expect(coordinates == 3);
};

[[test]]
fn shader_semantics_reject_patch_builtins_outside_their_stage() {
	rtsl::SourceFile source;
	@source.assign("patch-stage.rtsl", "struct Point { f32 value; }; template<typename T> struct patch {}; template<typename T> struct isoline_patch {}; [[stage : tess_eval]] fn invalid_current(patch<Point>& p) -> Point { return p.current; }; [[stage : tess_eval]] fn invalid_outer(patch<Point>& p) -> f32 { return p.outer[0]; }; [[stage : tess_control]] fn invalid_coordinate(isoline_patch<Point>& p) -> f32 { return p.coordinate; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	rt::test::expect((@sema.analyze()).has<rtsl::compilation_error>());
	rt::test::expect(diagnostics.diagnostics().size() == 3);
};

[[test]]
fn shader_semantics_accept_scalar_conversions_and_unseparated_else_blocks() {
	rtsl::SourceFile source;
	@source.assign("conversion.rtsl", "fn convert(f32 input) -> f32 { var result = f32(i32(input)); if (input < 0.0) { @result = 11.0; } else { @result = 22.0; }; return result; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	rt::test::expect((@sema.analyze()).has<void>());
	u32 function = context.decl_at(context.root)->members.data()[0];
	u32 first = context.stmt_at(context.decl_at(function)->body)->body.data()[0];
	u32 local = context.stmt_at(first)->declaration;
	u32 conversion = context.decl_at(local)->initializer;
	rt::test::expect(context.expr_at(conversion)->kind == rtsl::expr_kind::construct);
	rt::test::expect(context.type_at(context.expr_at(conversion)->type.type)->builtin == rtsl::builtin_type::floating);
	u32 operand = context.expr_at(conversion)->arguments.data()[0];
	rt::test::expect(context.type_at(context.expr_at(operand)->type.type)->builtin == rtsl::builtin_type::signed_integer);
};

[[test]]
fn shader_semantics_resolve_fields_parameters_and_inferred_locals() {
	rtsl::SourceFile source;
	@source.assign("shader.rt", "struct Vertex { f32 x; f32 y; }; [[stage : vertex]] fn main(Vertex point) -> f32 { var value = point.x + 2.0 * point.y; return value; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	rt::test::expect((@sema.analyze()).has<void>());
	rt::test::expect(!diagnostics.failed());
	u32 function = context.decl_at(context.root)->members.data()[1];
	rt::test::expect(context.type_at(context.decl_at(function)->type.type)->builtin == rtsl::builtin_type::floating);
	u32 body = context.decl_at(function)->body;
	u32 local = context.stmt_at(context.stmt_at(body)->body.data()[0])->declaration;
	rt::test::expect(context.type_at(context.decl_at(local)->type.type)->builtin == rtsl::builtin_type::floating);
};

[[test]]
fn shader_semantics_instantiate_independent_template_bodies() {
	rtsl::SourceFile source;
	@source.assign("generic.rt", "template<typename T> fn identity(T value) -> T { return value; }; fn first() -> f32 { return identity<f32>(2.0); }; fn second() -> i32 { return identity<i32>(3); };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	var analyzed = @sema.analyze();
	if (!analyzed.has<void>()) {
		for (usize index = 0; index < diagnostics.diagnostics().size(); @index = index + 1) {
			discard puts(diagnostics.diagnostics().data()[index].message.c_str());
			var location = diagnostics.diagnostics().data()[index].location;
			discard puts(rt::string(location.source->text().slice(location.begin, location.source->text().size() - location.begin)).c_str());
		};
	};
	rt::test::expect(analyzed.has<void>());
	rt::test::expect(!diagnostics.failed());
	usize instantiated = 0;
	for (usize index = 0; index < context.declarations.size(); @index = index + 1) {
		rtsl::Decl& declaration = context.declarations.data()[index];
		if (declaration.kind == rtsl::decl_kind::function && declaration.template_pattern) {
			@instantiated = instantiated + 1;
			rt::test::expect(declaration.parameters.size() == 0);
			rt::test::expect(declaration.body != context.decl_at(declaration.template_pattern)->body);
		};
	};
	rt::test::expect(instantiated == 2);
};

[[test]]
fn shader_semantics_bind_inherited_constructor_fields_and_constructor_calls() {
	rtsl::SourceFile source;
	@source.assign("construct.rt", "struct Base { f32 position; }; struct Derived : Base { fn Derived(var Derived& this, f32 value) { @position = value; }; }; fn make() -> Derived { return Derived(1.0); };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	rt::test::expect((@sema.analyze()).has<void>());
	bool bound = false;
	for (usize index = 0; index < context.expressions.size(); @index = index + 1) {
		rtsl::Expr& expression = context.expressions.data()[index];
		if (expression.kind == rtsl::expr_kind::construct) {
			rt::test::expect(expression.declaration != 0);
			rt::test::expect(context.decl_at(expression.declaration)->implicit_object);
			@bound = true;
		};
	};
	rt::test::expect(bound);
};

[[test]]
fn shader_semantics_specialize_record_fields_and_member_function_receivers() {
	rtsl::SourceFile source;
	@source.assign("record.rt", "template<typename T> struct Box { T value; fn get() -> T { return value; }; }; fn sample(Box<f32> box) -> f32 { return box.get(); };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	var analyzed = @sema.analyze();
	if (!analyzed.has<void>()) {
		for (usize index = 0; index < diagnostics.diagnostics().size(); @index = index + 1) {
			discard puts(diagnostics.diagnostics().data()[index].message.c_str());
		};
	};
	rt::test::expect(analyzed.has<void>());
	bool specialized = false;
	for (usize index = 0; index < context.declarations.size(); @index = index + 1) {
		rtsl::Decl& declaration = context.declarations.data()[index];
		if (declaration.kind == rtsl::decl_kind::function && declaration.receiver_type.type) {
			u32 record = context.type_at(declaration.receiver_type.type)->declaration;
			rt::test::expect(record != 0);
			u32 field = context.decl_at(record)->members.data()[0];
			rt::test::expect(context.type_at(context.decl_at(field)->type.type)->builtin == rtsl::builtin_type::floating);
			@specialized = true;
		};
	};
	rt::test::expect(specialized);
};

[[test]]
fn shader_semantics_report_unknown_values_without_losing_source_identity() {
	rtsl::SourceFile source;
	@source.assign("broken.rt", "fn main() -> f32 { return missing; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	var sema = rtsl::Sema(@context, @diagnostics);
	rt::test::expect(!(@sema.analyze()).has<void>());
	rt::test::expect(diagnostics.failed());
	rt::test::expect(diagnostics.diagnostics().data()[0].location.text() == "missing");
};
