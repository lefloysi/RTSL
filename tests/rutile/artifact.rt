fn "C" rtsl_test_artifact_parity(u08* bytes, u64 size) -> i32;

fn populated_artifact_module() -> rtsl::ir::Module {
	var builder = rtsl::ir::ModuleBuilder("parity");
	var symbol = @builder.symbol("compute", true);
	var parameter_symbol = @builder.symbol("input", false);
	var resource_symbol = @builder.symbol("texture", true);
	var uniform_symbol = @builder.symbol("uniform", false);
	var storage_symbol = @builder.symbol("storage", false);
	rtsl::ir::Type void_type;
	@void_type.kind = rtsl::ir::type_kind::void_type;
	var void_id = @builder.intern_type($void_type);
	rtsl::ir::Type integer;
	@integer.kind = rtsl::ir::type_kind::unsigned_integer;
	@integer.bit_width = 32;
	var integer_id = @builder.intern_type($integer);
	rtsl::ir::Type structure;
	@structure.kind = rtsl::ir::type_kind::structure;
	@structure.name = @builder.module.strings.intern("Payload");
	rtsl::ir::StructMember member;
	@member.name = @builder.module.strings.intern("value");
	@member.type = integer_id;
	@member.offset = rt::optional<u32>(16);
	@member.alignment = rt::optional<u32>(8);
	@structure.members.push_back($member);
	rtsl::ir::BuiltinMember builtin;
	@builtin.kind = rtsl::ir::builtin::position;
	@builtin.member_path.push_back(u32(0));
	@structure.builtin_members.push_back($builtin);
	var structure_id = @builder.intern_type($structure);
	rtsl::ir::Type signature;
	@signature.kind = rtsl::ir::type_kind::function;
	@signature.element_type = void_id;
	@signature.element_count = 7;
	@signature.space = rtsl::ir::address_space::resource;
	@signature.parameter_types.push_back(integer_id);
	discard @builder.intern_type($signature);
	rtsl::ir::Function function;
	@function.symbol = symbol;
	@function.return_type = void_id;
	@function.implicit_emitter = true;
	@function.implicit_decl = true;
	rtsl::ir::Parameter parameter;
	@parameter.value = @builder.value();
	@parameter.type = integer_id;
	@parameter.symbol = parameter_symbol;
	@parameter.kind = rt::optional<rtsl::ir::builtin>(rtsl::ir::builtin::global_invocation_x);
	var parameter_id = parameter.value;
	@function.parameters.push_back($parameter);
	var function_id = @builder.add_function($function);
	var first = @builder.add_block(function_id);
	var last = @builder.add_block(function_id);
	rtsl::ir::Instruction constant;
	@constant.operation = rtsl::ir::opcode::constant_integer;
	@constant.type = integer_id;
	@constant.immediates.push_back(u32(123));
	var constant_id = @builder.append(function_id, first, $constant);
	rtsl::ir::Instruction add;
	@add.operation = rtsl::ir::opcode::add;
	@add.type = integer_id;
	@add.operands.push_back(parameter_id);
	@add.operands.push_back(constant_id);
	var sum = @builder.append(function_id, first, $add);
	rtsl::ir::Successor successor;
	@successor.block = last;
	@successor.arguments.push_back(sum);
	rtsl::ir::Terminator branch;
	@branch.kind = rtsl::ir::terminator_kind::branch;
	@branch.successors.push_back($successor);
	@branch.immediates.push_back(u32(19));
	var first_block = @builder.block(function_id, first);
	@first_block->terminator = rt::optional<rtsl::ir::Terminator>($branch);
	@first_block->merge.kind = rtsl::ir::merge_kind::selection;
	@first_block->merge.merge_block = last;
	rtsl::ir::BlockArgument argument;
	@argument.value = @builder.value();
	@argument.type = integer_id;
	var last_block = @builder.block(function_id, last);
	@last_block->arguments.push_back($argument);
	rtsl::ir::Terminator returning;
	@returning.kind = rtsl::ir::terminator_kind::return_void;
	@last_block->terminator = rt::optional<rtsl::ir::Terminator>($returning);
	for (u32 i = 0; i < 5; @i = i + 1) {
		rtsl::ir::EntryPoint entry;
		@entry.symbol = symbol;
		@entry.function = function_id;
		@entry.source_name = @builder.module.strings.intern("parity.rtsl");
		if (i == 0) { @entry.kind = rtsl::ir::stage::vertex; }
		else if (i == 1) {
			@entry.kind = rtsl::ir::stage::tessellation_control;
			rtsl::ir::TessellationControlConfiguration configuration;
			@configuration.output_control_points = 3;
			@entry.configuration = $configuration;
		} else if (i == 2) {
			@entry.kind = rtsl::ir::stage::tessellation_evaluation;
			rtsl::ir::TessellationEvaluationConfiguration configuration;
			@configuration.domain = rtsl::ir::tessellation_domain::quads;
			@configuration.spacing = rtsl::ir::tessellation_spacing::fractional_odd;
			@configuration.order = rtsl::ir::winding::counter_clockwise;
			@entry.configuration = $configuration;
		} else if (i == 3) {
			@entry.kind = rtsl::ir::stage::geometry;
			rtsl::ir::GeometryConfiguration configuration;
			@configuration.input = rtsl::ir::primitive_topology::triangles_adjacency;
			@configuration.output = rtsl::ir::primitive_topology::triangle_strip;
			@configuration.maximum_vertices = 12;
			@configuration.invocations = 2;
			@entry.configuration = $configuration;
		} else {
			@entry.kind = rtsl::ir::stage::compute;
			rtsl::ir::ComputeConfiguration configuration;
			@configuration.workgroup_size[0] = 8;
			@configuration.workgroup_size[1] = 4;
			@configuration.workgroup_size[2] = 2;
			@entry.configuration = $configuration;
		};
		rtsl::ir::EntryAttribute attribute;
		@attribute.name = @builder.module.strings.intern("attribute");
		@attribute.tokens.push_back(@builder.module.strings.intern("token"));
		@entry.attributes.push_back($attribute);
		rtsl::ir::InterfaceContract contract;
		@contract.parameter_index = 0;
		@contract.member_path.push_back(@builder.module.strings.intern("value"));
		@contract.contract = @builder.module.strings.intern("contract");
		@entry.parameter_contracts.push_back($contract);
		@builder.module.entry_points.push_back($entry);
	};
	rtsl::ir::Binding binding;
	@binding.set = 3;
	@binding.binding = 7;
	rtsl::ir::Resource resource;
	@resource.symbol = resource_symbol;
	@resource.kind = rtsl::ir::resource_kind::storage_texture;
	@resource.type = structure_id;
	@resource.access = rtsl::ir::access_kind::read_write;
	@resource.binding = rt::optional<rtsl::ir::Binding>(binding);
	@resource.users.push_back(function_id);
	@builder.module.resources.push_back($resource);
	rtsl::ir::Uniform uniform;
	@uniform.symbol = uniform_symbol;
	@uniform.type = structure_id;
	@uniform.binding = rt::optional<rtsl::ir::Binding>(binding);
	@uniform.offset = rt::optional<u32>(32);
	@uniform.size = rt::optional<u32>(64);
	@uniform.alignment = rt::optional<u32>(16);
	@builder.module.uniforms.push_back($uniform);
	rtsl::ir::StorageObject storage;
	@storage.symbol = storage_symbol;
	@storage.type = integer_id;
	@storage.space = rtsl::ir::address_space::workgroup;
	@storage.access = rtsl::ir::access_kind::write_only;
	@storage.binding = rt::optional<rtsl::ir::Binding>(binding);
	@storage.initializer = rt::optional<u32>(constant_id);
	@builder.module.storage_objects.push_back($storage);
	return rtsl::ir::Module(builder.module);
};

[[test]]
fn artifacts_round_trip_every_section_and_match_the_existing_reader() {
	var module = populated_artifact_module();
	rtsl::DiagnosticsEngine diagnostics;
	rt::test::expect(rtsl::verify_module(module, @diagnostics));
	var bytes = rtsl::write_artifact(module, rtsl::artifact_kind::program);
	rt::test::expect(rtsl_test_artifact_parity(bytes.data(), static_cast<u64>(bytes.size())) == 0);
	var decoded = rtsl::read_artifact(rt::span<u08>(bytes.data(), bytes.size()));
	rt::test::expect(decoded.has<rtsl::Artifact>());
	var artifact = &decoded.get<rtsl::Artifact>();
	rt::test::expect(artifact->kind == rtsl::artifact_kind::program);
	var encoded = rtsl::write_artifact(artifact->module, artifact->kind);
	rt::test::expect(encoded.size() == bytes.size());
	for (usize i = 0; i < bytes.size(); @i = i + 1) { rt::test::expect(encoded.data()[i] == bytes.data()[i]); };
};

fn artifact_word(var rt::buffer<u08>& bytes, usize offset, u32 value) {
	var data = (@bytes).data();
	for (u32 shift = 0; shift < 32; @shift = shift + 8) { @data[offset + static_cast<usize>(shift / 8)] = static_cast<u08>(value >> shift); };
};

fn artifact_offset(rt::buffer<u08>& bytes, usize section) -> usize {
	u32 value = 0;
	for (u32 shift = 0; shift < 32; @shift = shift + 8) {
		@value = value + (static_cast<u32>(bytes.data()[32 + section * 24 + static_cast<usize>(shift / 8)]) << shift);
	};
	return static_cast<usize>(value);
};

fn expect_artifact_error(rt::buffer<u08>& bytes, rtsl::artifact_error_code code) {
	var decoded = rtsl::read_artifact(rt::span<u08>(bytes.data(), bytes.size()));
	rt::test::expect(decoded.has<rtsl::artifact_error>());
	var error = &decoded.get<rtsl::artifact_error>();
	rt::test::expect(error->code == code);
	rt::test::expect(error->message.size() != 0);
	rt::test::expect(error->offset <= bytes.size());
};

[[test]]
fn artifact_reader_rejects_malformed_headers_directories_and_records() {
	var module = populated_artifact_module();
	var original = rtsl::write_artifact(module, rtsl::artifact_kind::program);
	for (usize size = 0; size < 24; @size = size + 1) {
		var decoded = rtsl::read_artifact(rt::span<u08>(original.data(), size));
		rt::test::expect(decoded.has<rtsl::artifact_error>());
	};
	var bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, 0, 0);
	expect_artifact_error(bytes, rtsl::artifact_error_code::invalid_magic);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, 17, 8);
	expect_artifact_error(bytes, rtsl::artifact_error_code::unsupported_version);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, 12, 0);
	expect_artifact_error(bytes, rtsl::artifact_error_code::wrong_endian_marker);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, 48, 1);
	expect_artifact_error(bytes, rtsl::artifact_error_code::duplicate_section);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, 32, u32::max);
	expect_artifact_error(bytes, rtsl::artifact_error_code::invalid_directory);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, 240, u32::max);
	expect_artifact_error(bytes, rtsl::artifact_error_code::invalid_count);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, 244, 16777216);
	expect_artifact_error(bytes, rtsl::artifact_error_code::truncated);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, artifact_offset(bytes, 2) + 8, 255);
	expect_artifact_error(bytes, rtsl::artifact_error_code::invalid_enum);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, artifact_offset(bytes, 3) + 12, 2);
	expect_artifact_error(bytes, rtsl::artifact_error_code::invalid_enum);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, artifact_offset(bytes, 1), u32::max);
	expect_artifact_error(bytes, rtsl::artifact_error_code::invalid_reference);
	@bytes = rt::buffer<u08>(original);
	artifact_word(@bytes, 56, 240);
	expect_artifact_error(bytes, rtsl::artifact_error_code::invalid_directory);
};

[[test]]
fn ir_verification_reports_invalid_values_calls_successors_and_stage_metadata() {
	var module = populated_artifact_module();
	var function = (@module).find_function(1);
	var block = &@(@function->blocks).data()[0];
	var instruction = &@(@block->instructions).data()[1];
	@(@instruction->operands).data()[0] = 999;
	@block->merge.merge_block = 999;
	var terminator = &@(@block->terminator).value();
	@(@terminator->successors).data()[0].block = 999;
	var entry = &@(@module.entry_points).data()[4];
	@entry->configuration = rtsl::ir::ComputeConfiguration();
	rtsl::DiagnosticsEngine diagnostics;
	rt::test::expect(!rtsl::verify_module(module, @diagnostics));
	rt::test::expect(diagnostics.diagnostics().size() >= 4);
	var bytes = rtsl::write_artifact(module, rtsl::artifact_kind::object);
	expect_artifact_error(bytes, rtsl::artifact_error_code::invalid_ir);
};

[[test]]
fn ir_verification_checks_call_argument_and_result_signatures() {
	for (u32 scenario = 0; scenario < 3; @scenario = scenario + 1) {
		var module = populated_artifact_module();
		var function = (@module).find_function(1);
		var block = &@(@function->blocks).data()[0];
		var instruction = &@(@block->instructions).data()[1];
		@instruction->operation = rtsl::ir::opcode::call;
		@instruction->callee = 1;
		if (scenario != 0) { @instruction->operands.pop_back(); };
		if (scenario == 1) {
			var parameter = &@(@function->parameters).data()[0];
			@parameter->type = 3;
			@(@instruction->operands).data()[0] = block->instructions.data()[0].result;
		};
		rtsl::DiagnosticsEngine diagnostics;
		rt::test::expect(!rtsl::verify_module(module, @diagnostics));
		rt::test::expect(diagnostics.diagnostics().size() != 0);
		bool found = false;
		for (usize i = 0; i < diagnostics.diagnostics().size(); @i = i + 1) {
			var message = diagnostics.diagnostics().data()[i].message.view();
			if (scenario == 0 && message.contains("call argument count")) { @found = true; };
			if (scenario == 1 && message.contains("call argument type")) { @found = true; };
			if (scenario == 2 && message.contains("call result type")) { @found = true; };
		};
		rt::test::expect(found);
	};
};
