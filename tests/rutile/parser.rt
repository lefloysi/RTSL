[[test]]
fn shader_parser_builds_retained_ast_for_rutile_declarations_and_attributes() {
	rtsl::SourceFile source;
	@source.assign("shader.rt", "struct Vertex { f32 x; f32 y; }; [[stage : vertex]] fn main(Vertex point) -> f32 { var value = point.x + 2.0 * point.y; return value; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	rt::test::expect(!diagnostics.failed());
	rt::test::expect(context.decl_at(context.root)->members.size() == 2);
	u32 function = context.decl_at(context.root)->members.data()[1];
	rt::test::expect(context.decl_at(function)->name.text() == "main");
	rt::test::expect(context.decl_at(function)->attributes.size() == 1);
	rt::test::expect(context.decl_at(function)->attributes.data()[0].name.text() == "stage");
	rt::test::expect(context.decl_at(function)->members.size() == 1);
	u32 body = context.decl_at(function)->body;
	rt::test::expect(context.stmt_at(body)->kind == rtsl::stmt_kind::compound);
	rt::test::expect(context.stmt_at(body)->body.size() == 2);
};

[[test]]
fn shader_parser_supports_scoped_loops_and_mutation_expressions() {
	rtsl::SourceFile source;
	@source.assign("loop.rt", "fn sum(i32 count) -> i32 { var result = 0; for (var index = 0; index < count; @index = index + 1) { @result = result + index; }; return result; };");
	var lexer = rtsl::Lexer(@source);
	rt::test::expect((@lexer.scan()).has<void>());
	rtsl::ASTContext context;
	rtsl::DiagnosticsEngine diagnostics;
	var parser = rtsl::Parser(@source, @context, @diagnostics);
	rt::test::expect((@parser.parse()).has<void>());
	u32 function = context.decl_at(context.root)->members.data()[0];
	u32 body = context.decl_at(function)->body;
	u32 loop = context.stmt_at(body)->body.data()[1];
	rt::test::expect(context.stmt_at(loop)->kind == rtsl::stmt_kind::for_loop);
	rt::test::expect(context.stmt_at(loop)->initialization != 0);
	rt::test::expect(context.stmt_at(loop)->increment != 0);
};
