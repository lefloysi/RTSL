fn rtsl_settings(var kiln::Target& target, kiln::Options& options) {
	@target.option("standard", "c++latest");
	if (options.host_os() == "windows") {
		@target.option("runtime", "MT");
	};
	@target.option("includes", "include");
};

template<typename Target>
fn rtsl_runtime_sources(var Target& target) {
	@target.sources.add("src/IR/IR.cpp");
	@target.sources.add("src/IR/Verifier.cpp");
	@target.sources.add("src/Serialization/Artifact.cpp");
};

fn build(kiln::Options& options) {
	var compiler = kiln::add_target("rtsl", kiln::TargetType::static_lib);
	@compiler.option("build_machine", "host");
	rtsl_settings(@compiler, options);
	@compiler.import("std");
	@compiler.sources.add("source/rtsl");
	@compiler.sources.add("source/platform.cpp");
	@compiler.sources.add("source/format_files.cpp");
	var runtime = kiln::add_target("rtsl-runtime", kiln::TargetType::static_lib);
	@runtime.option("standard", "c++latest");
	@runtime.option("includes", "include");
	if (options.os() == "windows") { @runtime.option("runtime", "MT"); };
	if (options.os() == "windows" && options.profile() == "debug") { @runtime.option("runtime", "MTd"); };
	rtsl_runtime_sources(@runtime);
	var tests = kiln::add_tests(compiler);
	@tests.sources.add("tests/rutile");
	@tests.option("includes", "include");
	if (options.host_os() == "windows") { @tests.option("runtime", "MT"); };
	@tests.option("runtime_files", "tests/inputs/Shaders/bezier.rtsl");
	@tests.option("runtime_directories", "{\"std\":\"std\"}");
	rtsl_runtime_sources(@tests);

	var driver = kiln::add_target("rtslc", kiln::TargetType::executable);
	@driver.option("build_machine", "host");
	rtsl_settings(@driver, options);
	@driver.sources.add("tools/rtslc/main.rt");
	@driver.depends_on("rtsl");
	@driver.import("std");
	@driver.option("runtime_directories", "{\"std\":\"std\"}");
	if (options.host_os() == "windows") { @driver.option("link_options", "shell32.lib"); };
	var language_server = kiln::add_target("rtsl-lsp", kiln::TargetType::executable);
	@language_server.option("build_machine", "host");
	rtsl_settings(@language_server, options);
	@language_server.sources.add("tools/rtsl-lsp/main.rt");
	@language_server.depends_on("rtsl");
	@language_server.import("std");
	@language_server.option("runtime_directories", "{\"std\":\"std\"}");
	var lexical_adapter = kiln::add_target("rtsl-lexer", kiln::TargetType::shared_lib);
	@lexical_adapter.option("build_machine", "host");
	rtsl_settings(@lexical_adapter, options);
	@lexical_adapter.sources.add("tools/rtsl-lexer/main.rt");
	@lexical_adapter.depends_on("rtsl");
	@lexical_adapter.import("std");
	if (options.host_os() == "windows") { @lexical_adapter.option("link_options", "/EXPORT:rtsl_lexical_spans"); };
};
