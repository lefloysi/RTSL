namespace rtsl {
	fn interface_token_kind(Token& token) -> u16 {
		if (token.kind == token_kind::literal_number) { return 3; };
		if (token.kind == token_kind::literal_string) { return 4; };
		if (token.is("[")) { return 5; };
		if (token.is("]")) { return 6; };
		if (token.is("(")) { return 7; };
		if (token.is(")")) { return 8; };
		if (token.is("{")) { return 9; };
		if (token.is("}")) { return 10; };
		if (token.is(".")) { return 11; };
		if (token.is("...")) { return 12; };
		if (token.is("&")) { return 13; };
		if (token.is("&&")) { return 14; };
		if (token.is("&=")) { return 15; };
		if (token.is("*")) { return 16; };
		if (token.is("*=")) { return 17; };
		if (token.is("+")) { return 18; };
		if (token.is("++")) { return 19; };
		if (token.is("+=")) { return 20; };
		if (token.is("-")) { return 21; };
		if (token.is("->")) { return 22; };
		if (token.is("--")) { return 23; };
		if (token.is("-=")) { return 24; };
		if (token.is("~")) { return 25; };
		if (token.is("!")) { return 26; };
		if (token.is("!=")) { return 27; };
		if (token.is("/")) { return 28; };
		if (token.is("/=")) { return 29; };
		if (token.is("%")) { return 30; };
		if (token.is("%=")) { return 31; };
		if (token.is("<")) { return 32; };
		if (token.is("<-")) { return 33; };
		if (token.is("<<")) { return 34; };
		if (token.is("<=")) { return 35; };
		if (token.is("<<=")) { return 36; };
		if (token.is("<=>")) { return 37; };
		if (token.is(">")) { return 38; };
		if (token.is(">>")) { return 39; };
		if (token.is(">=")) { return 40; };
		if (token.is(">>=")) { return 41; };
		if (token.is("^")) { return 42; };
		if (token.is("^^")) { return 43; };
		if (token.is("^=")) { return 44; };
		if (token.is("|")) { return 45; };
		if (token.is("||")) { return 46; };
		if (token.is("|=")) { return 47; };
		if (token.is("?")) { return 48; };
		if (token.is(":")) { return 49; };
		if (token.is("::")) { return 50; };
		if (token.is(":=")) { return 51; };
		if (token.is(";")) { return 52; };
		if (token.is("=")) { return 53; };
		if (token.is("==")) { return 54; };
		if (token.is(",")) { return 55; };
		if (token.is("@")) { return 56; };
		if (token.is("import")) { return 57; };
		if (token.is("struct")) { return 58; };
		if (token.is("using")) { return 59; };
		if (token.is("var")) { return 60; };
		if (token.is("const")) { return 61; };
		if (token.is("static")) { return 62; };
		if (token.is("export")) { return 63; };
		if (token.is("uniform")) { return 64; };
		if (token.is("storage")) { return 65; };
		if (token.is("fn")) { return 66; };
		if (token.is("if")) { return 67; };
		if (token.is("else")) { return 68; };
		if (token.is("return")) { return 69; };
		if (token.is("emit")) { return 70; };
		if (token.is("template")) { return 71; };
		if (token.is("typename")) { return 72; };
		if (token.is("operator")) { return 73; };
		if (token.kind == token_kind::identifier) { return 2; };
		return 0;
	};
};
