namespace rtsl {
	export struct SourceFile {
		fn SourceFile(var SourceFile& this) : [default];

		fn assign(var SourceFile& this, rt::string_view path, rt::string_view text);
		fn append_token(var SourceFile& this, Token token);
		fn append_comment(var SourceFile& this, Token comment);
		fn clear_tokens(var SourceFile& this);

		fn path(SourceFile& this) -> rt::string_view;
		fn text(SourceFile& this) -> rt::string_view;
		fn line(SourceFile& this, usize number) -> rt::string_view;
		fn tokens(SourceFile& this) -> rt::buffer<Token>&;
		fn comments(SourceFile& this) -> rt::buffer<Token>&;
		fn token_count(SourceFile& this) -> usize;

	private:
		rt::string file_path;
		rt::string contents;
		rt::buffer<usize> line_offsets;
		rt::buffer<Token> token_buffer;
		rt::buffer<Token> comment_buffer;
	};

	export struct SourceManager {
		fn add(var SourceManager& this, rt::string_view path, rt::string_view text) -> var SourceFile*;
		fn at(auto SourceManager& this, usize index) -> const[this] SourceFile*;
		fn clear(var SourceManager& this);

		fn count(SourceManager& this) -> usize;

	private:
		rt::buffer<rt::unique<SourceFile>> files;
	};

	export fn SourceFile::assign(var SourceFile& this, rt::string_view path, rt::string_view text) {
		rt::string next_path;
		rt::string next_text;
		rt::buffer<usize> next_lines;

		@next_path.append(path);
		@next_text.append(text);
		@next_lines.push_back(0);

		usize offset = 0;

		while (offset < text.size()) {
			if (text.data()[offset] == '\n') {
				@next_lines.push_back(offset + 1);
			};

			@offset = offset + 1;
		};

		@this.token_buffer.clear();
		@this.comment_buffer.clear();
		@this.file_path = $next_path;
		@this.contents = $next_text;
		@this.line_offsets = $next_lines;

	};

	export fn SourceFile::path(SourceFile& this) -> rt::string_view {
		return this.file_path.view();
	};

	export fn SourceFile::text(SourceFile& this) -> rt::string_view {
		return this.contents.view();
	};

	export fn SourceFile::line(SourceFile& this, usize number) -> rt::string_view {
		if (!number || number > this.line_offsets.size()) {
			return rt::string_view();
		};

		usize begin = this.line_offsets.data()[number - 1];
		usize end = this.contents.size();

		if (number < this.line_offsets.size()) {
			@end = this.line_offsets.data()[number] - 1;
		};

		if (end > begin && this.contents.data()[end - 1] == '\r') {
			@end = end - 1;
		};

		return rt::string_view(this.contents.data() + begin, end - begin);
	};

	export fn SourceFile::tokens(SourceFile& this) -> rt::buffer<Token>& {
		return this.token_buffer;
	};

	export fn SourceFile::comments(SourceFile& this) -> rt::buffer<Token>& {
		return this.comment_buffer;
	};

	export fn SourceFile::token_count(SourceFile& this) -> usize {
		return this.token_buffer.size();
	};

	export fn SourceFile::append_token(var SourceFile& this, Token token) {
		@this.token_buffer.push_back($token);
	};

	export fn SourceFile::append_comment(var SourceFile& this, Token comment) {
		@this.comment_buffer.push_back($comment);
	};

	export fn SourceFile::clear_tokens(var SourceFile& this) {
		@this.token_buffer.clear();
		@this.comment_buffer.clear();
	};

	export fn SourceManager::add(var SourceManager& this, rt::string_view path, rt::string_view text) -> var SourceFile* {
		rt::unique<SourceFile> file = rt::unique<SourceFile>::make();

		@file.get()->assign(path, text);

		var SourceFile* result = file.get();

		@this.files.push_back($file);

		return result;
	};

	export fn SourceManager::count(SourceManager& this) -> usize {
		return this.files.size();
	};

	export fn SourceManager::at(auto SourceManager& this, usize index) -> const[this] SourceFile* {
		if (index >= this.files.size()) {
			return nullptr;
		};

		return const_cast<const[this] SourceFile*>(this.files.data()[index].get());
	};

	export fn SourceManager::clear(var SourceManager& this) {
		@this.files.clear();
	};



};
