struct FormatFiles;
fn system(char* command) -> i32;
fn rtsl_format_files_create(char* text, usize size) -> var FormatFiles*;
fn rtsl_format_files_command(var FormatFiles* files, char* executable, char* assumed) -> char*;
fn rtsl_format_files_output(var FormatFiles* files, var usize* size) -> char*;
fn rtsl_format_files_destroy(var FormatFiles* files);

export struct FormatFilesDelete {
	fn dispose(var FormatFiles* files);
};

export fn FormatFilesDelete::dispose(var FormatFiles* files) {
	rtsl_format_files_destroy(files);
};

namespace rtsl::lsp {
	fn formatted(Document& document) -> rt::string {
		var files = rt::unique<FormatFiles, FormatFilesDelete>(rtsl_format_files_create(document.text.data(), document.text.size()));
		if (!files.get()) { return rt::string(document.text); };
		rt::string assumed = uri_path(document.uri) + ".cpp";
		rt::buffer<rt::string> candidates;
		rt::string configured = rt::environment("RTSL_FORMATTER");
		if (!configured.empty()) { @candidates.push_back($configured); };
		rt::string visual_studio = rt::environment("VSINSTALLDIR");
		if (!visual_studio.empty()) { @candidates.push_back(visual_studio + "VC/Tools/Llvm/x64/bin/clang-format.exe"); };
		@candidates.push_back("C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin/clang-format.exe");
		@candidates.push_back("C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/Llvm/x64/bin/clang-format.exe");
		@candidates.push_back("C:/Program Files/Microsoft Visual Studio/2022/Enterprise/VC/Tools/Llvm/x64/bin/clang-format.exe");
		@candidates.push_back("clang-format");
		for (usize index = 0; index < candidates.size(); @index = index + 1) {
			var command = rtsl_format_files_command(files.get(), candidates.data()[index].c_str(), assumed.c_str());
			if (!command) { continue; };
			i32 result = system(command);
			if (result) { continue; };
			usize size = 0;
			var output = rtsl_format_files_output(files.get(), &@size);
			if (!output) { continue; };
			var text = rt::string(rt::string_view(output, size));
			return $text;
		};
		return rt::string(document.text);
	};

	fn formatting(Document& document) -> rt::string {
		var next = formatted(document);
		if (next == document.text) { return rt::string("[]"); };
		return rt::string("[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":") + position(document.text, document.text.size()) + "},\"newText\":" + quote(next) + "}]";
	};

	fn on_type_formatting(Document& document, usize offset) -> rt::string {
		if (offset > document.text.size()) { @offset = document.text.size(); };
		usize begin = offset;
		while (begin && document.text.data()[begin - 1] != '\n') { @begin = begin - 1; };
		usize end = begin;
		while (end < document.text.size() && (document.text.data()[end] == ' ' || document.text.data()[end] == '\t')) { @end = end + 1; };
		usize braces = 0;
		SourceFile source;
		@source.assign(document.uri, document.text);
		var lexer = Lexer(@source);
		discard @lexer.scan();
		for (usize index = 0; index < source.tokens().size(); @index = index + 1) {
			Token& token = source.tokens().data()[index];
			if (token.begin >= begin) { break; };
			if (token.kind == token_kind::punct_left_brace) { @braces = braces + 1; }
			else if (token.kind == token_kind::punct_right_brace && braces) { @braces = braces - 1; };
		};
		if (end < document.text.size() && document.text.data()[end] == '}' && braces) { @braces = braces - 1; };
		rt::string indentation;
		for (usize index = 0; index < braces; @index = index + 1) { @indentation.append("\t"); };
		if (indentation == document.text.view().slice(begin, end - begin)) { return rt::string("[]"); };
		return rt::string("[{\"range\":{\"start\":") + position(document.text, begin) + ",\"end\":" + position(document.text, end) + "},\"newText\":" + quote(indentation) + "}]";
	};
};
