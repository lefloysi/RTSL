struct RtslLexicalSpan { u32 offset; u32 length; u32 category; };

fn "C" rtsl_lexical_spans(char* text, u32 text_length, var RtslLexicalSpan* spans, u32 capacity) -> u32 {
 if (!text || !spans) { return 0; };
 rtsl::SourceFile source;
 @source.assign("<editor>", rt::string_view(text,static_cast<usize>(text_length)));
 var lexer=rtsl::Lexer(@source);
 discard @lexer.scan();
 rt::buffer<rtsl::Token>& tokens=source.tokens();
 rt::buffer<rtsl::Token>& comments=source.comments();
 usize token_index=0;
 usize comment_index=0;
 u32 count=0;
 usize attribute_depth=0;
 while(token_index<tokens.size() || comment_index<comments.size()) {
  rtsl::Token token;
  u32 category=6;
  if(comment_index<comments.size() && (token_index==tokens.size() || comments.data()[comment_index].begin<tokens.data()[token_index].begin)) {
   @token=rtsl::Token(comments.data()[comment_index]); @comment_index=comment_index+1;
  } else {
   @token=rtsl::Token(tokens.data()[token_index]); @token_index=token_index+1;
   if(token.kind==rtsl::token_kind::eof){continue;};
   if(token.kind==rtsl::token_kind::punct_left_bracket && token_index<tokens.size() && tokens.data()[token_index].kind==rtsl::token_kind::punct_left_bracket){@attribute_depth=2;};
   if(attribute_depth){@category=7;if(token.kind==rtsl::token_kind::punct_right_bracket){@attribute_depth=attribute_depth-1;};}
   else if(token.kind>=rtsl::token_kind::kw_fn && token.kind<=rtsl::token_kind::kw_sizeof){
    @category=1;
    if(token.kind==rtsl::token_kind::kw_if || token.kind==rtsl::token_kind::kw_else || token.kind==rtsl::token_kind::kw_for || token.kind==rtsl::token_kind::kw_while || token.kind==rtsl::token_kind::kw_return || token.kind==rtsl::token_kind::kw_break || token.kind==rtsl::token_kind::kw_continue){@category=2;};
   }
   else if(token.kind==rtsl::token_kind::literal_number){@category=3;}
   else if(token.kind==rtsl::token_kind::literal_string){@category=4;}
   else if(token.kind==rtsl::token_kind::identifier){
    @category=0;
    if(token.is("emit")){@category=2;}
    else if(token.is("uniform") || token.is("storage") || token.is("import") || token.is("static") || token.is("true") || token.is("false")){@category=1;};
   }
   else if((token.kind>=rtsl::token_kind::punct_ellipsis && token.kind<=rtsl::token_kind::punct_colon) || token.kind==rtsl::token_kind::op_scope || token.kind==rtsl::token_kind::op_dot){@category=8;}
   else {@category=5;};
  };
  if(count==capacity){return 0;};
  @spans[count].offset=static_cast<u32>(token.begin);
  @spans[count].length=static_cast<u32>(token.length);
  @spans[count].category=category;
  @count=count+1;
 };
 return count;
};
